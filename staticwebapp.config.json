{
  "globalHeaders": {
    "cache-control": "no-cache, no-store, must-revalidate",
    "pragma": "no-cache",
    "expires": "0"
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/*.png",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/*.ico",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    }
  ]
}